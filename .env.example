# Copy to .env. Values are local examples/placeholders, never real credentials.
# Existing process environment variables take precedence over .env.

# AI: leave keys empty for setup/tests; add your own key for AI features.
# Gemini is tried first; Groq is the fallback. Model names are the code defaults.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_TIMEOUT_SECONDS=30

# Web: replace this placeholder with your own long random secret.
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# Leave optional overrides commented so Docker retains its bind address/log path.
# HOST=127.0.0.1
# PORT=5000
# LOG_FILE=nutrilenz.log

# Compose fixes the app's storage/host/port/user/name for its own services.
NUTRILENZ_STORAGE=mysql
DB_PASSWORD=change-me-local-db-password
DB_ROOT_PASSWORD=change-me-local-root-password
# For python main.py with your own MySQL server (not needed with Compose):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=nutrilenz
# DB_NAME=nutrilenz

# Seed demo users/products only when the store is empty.
SEED_DEMO_DATA=true
# Number of background workers; the code enforces a minimum of 1.
WORKER_THREADS=3

# Optional destructive MySQL contract tests: use a separate disposable database.
# NUTRILENZ_TEST_MYSQL=1
# TEST_DB_NAME=nutrilenz_test
