# Copy this file to ".env" and fill in your own values. Never commit .env.

# --- AI (at least one key is needed) ---
# Gemini is used first and reads label photos. Groq is the backup.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Web ---
# Any long random text. Keeps people logged in across restarts.
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
# "mysql" (default, use with docker compose) or "memory" (no database, data lost on exit)
NUTRILENZ_STORAGE=mysql
DB_PASSWORD=nutrilenz-dev-password
# Only needed when running python main.py outside Docker against your own MySQL:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=nutrilenz
# DB_NAME=nutrilenz

# Add the demo accounts (jane / sam) and products when the database is empty
SEED_DEMO_DATA=true
# How many AI jobs can run at the same time
WORKER_THREADS=3
